{
  "name": "scanner",
  "version": "0.0.1",
  "private": true,
  "description": "手机网页扫描工具：拍照、透视校正、A4 PDF、Supabase 资料库",
  "repository": "https://github.com/101arrowz/scanner",
  "author": "Arjun Barrett",
  "license": "MIT",
  "scripts": {
    "start": "parcel src/index.html src/library.html",
    "build-wasm": "wasm-pack build --target web",
    "build": "tsc && tsc -p src/workers/tsconfig.json && tsc -p src/tsconfig.service-worker.json && parcel build src/index.html src/library.html --public-url ."
  },
  "devDependencies": {
    "@parcel/compressor-brotli": "^2.9.3",
    "@parcel/compressor-gzip": "^2.9.3",
    "@parcel/packager-raw-url": "^2.9.3",
    "@types/w3c-image-capture": "^1.0.7",
    "parcel": "^2.9.3",
    "parcel-config-pwa-manifest": "^0.1.5",
    "typescript": "^5.2.2"
  },
  "dependencies": {
    "@parcel/service-worker": "^2.9.3",
    "@supabase/supabase-js": "^2.119.0",
    "image-capture": "^0.4.0"
  }
}
